# Firebase Admin SDK (backend) — Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Paste the full JSON on one line:
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"stargym-bec65",...}
# Or set path to the downloaded key file instead:
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Firebase client config — src/services/firebase.ts
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# EmailJS — src/services/email.ts
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
ADMIN_EMAIL=

# EmailJS template must have these variables mapped:
#   {{to_email}}, {{member_name}}, {{member_email}}, {{signup_date}}

# Razorpay — api/routes/payments.js + api/routes/webhooks.js
# Dashboard → Settings → API Keys (use test keys for dev, live keys for prod)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Dashboard → Settings → Webhooks → Webhook Secret
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx
