rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Members may only touch safe profile fields on their own doc
    function memberProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['displayName', 'phone', 'age', 'gender']);
    }

    match /checkins/{docId} {
      // docId format: {uid}_{YYYY-MM-DD} — uid must match the requester
      allow create: if signedIn() &&
        docId.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow read: if isAdmin();
    }

    match /gymConfig/{docId} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    match /errorLogs/{logId} {
      allow create: if signedIn();
      allow read:   if isAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Self-signup must start as 'member'; admin can create any profile
      allow create: if (isOwner(uid) && request.resource.data.role == 'member') || isAdmin();
      // Members can only update safe fields; admins can update anything
      allow update: if isAdmin() || (isOwner(uid) && memberProfileUpdate());
      allow delete: if isAdmin();

      match /attendance/{date} {
        allow read:           if isOwner(uid) || isAdmin();
        allow create:         if isOwner(uid);
        allow update, delete: if isAdmin();
      }

      match /workouts/{date} {
        allow read:          if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid);
        allow delete:        if isAdmin();
      }
    }
  }
}
